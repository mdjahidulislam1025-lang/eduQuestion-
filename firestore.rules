rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role helpers
    function isSuperOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'mdjahidulislam1025@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isUser(userId) || isSuperOwner();
      allow list: if isSuperOwner();
      allow create: if isUser(userId) && incoming().uid == userId && (!('role' in incoming()) || incoming().role == 'USER' || isSuperOwner());
      allow update: if isUser(userId) && incoming().uid == existing().uid && (isSuperOwner() || incoming().get('role', 'USER') == existing().get('role', 'USER'));
      allow delete: if isUser(userId) || isSuperOwner();
    }

    // Workspaces & Branding (Public workspace header read by ID only; writes restricted to owner)
    match /workspaces/{workspaceId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update, delete: if isSuperOwner();
    }

    // Workspace Members
    match /workspace_members/{memberId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperOwner();
    }

    // Source Documents (Uploaded NCTB textbooks & board exam PDFs)
    match /source_documents/{documentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrOwner();
    }

    // Textbooks
    match /textbooks/{textbookId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrOwner();
    }

    // Board Questions
    match /board_questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrOwner();
    }

    // Saved Questions (Full Question Bank - Strictly requires sign-in via Google/Gmail or Email)
    match /saved_questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(questionId)
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().subject is string && incoming().subject.size() <= 128
        && incoming().questionType in ['MCQ', 'SQ', 'CQ']
        && (!('questionText' in incoming()) || (incoming().questionText is string && incoming().questionText.size() <= 25000));
      allow update: if isSignedIn() && isValidId(questionId)
        && (isAdminOrOwner() || existing().get('ownerId', '') == request.auth.uid || !('ownerId' in existing()))
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().subject is string && incoming().subject.size() <= 128
        && incoming().questionType in ['MCQ', 'SQ', 'CQ']
        && (!('questionText' in incoming()) || (incoming().questionText is string && incoming().questionText.size() <= 25000));
      allow delete: if isAdminOrOwner() || (isSignedIn() && existing().get('ownerId', '') == request.auth.uid);
    }

    // Unified Central Repository Content & Knowledge
    match /repository_content/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrOwner();
    }

    // Admin Uploaded PDFs
    match /admin_pdfs/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrOwner();
    }

    // NCTB Books
    match /nctb_books/{bookId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrOwner();
    }

    // Question Papers (User-owned or Super Owner)
    match /question_papers/{paperId} {
      allow get, list: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperOwner());
      allow create: if isSignedIn() && isValidId(paperId) && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperOwner());
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow get, list: if isAdminOrOwner() || (isSignedIn() && existing().get('userId', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if false; // immutable audit log
    }

    function isAdminOrOwner() {
      return isSuperOwner() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN']
      );
    }

    // Dynamic Classes
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrOwner();
    }

    // Dynamic & Custom Subjects
    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrOwner() || (isSignedIn() && existing().createdBy == request.auth.uid);
    }

    // Exam Name Presets
    match /examPresets/{presetId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrOwner() || (isSignedIn() && existing().createdBy == request.auth.uid);
    }

    // User Saved Configurations
    match /userConfigurations/{configId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isSuperOwner());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isSuperOwner());
    }

    // Question Papers (camelCase alias)
    match /questionPapers/{paperId} {
      allow get, list: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperOwner());
      allow create: if isSignedIn() && isValidId(paperId) && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperOwner());
    }

    // Public / User Submitted Questions
    match /submitted_questions/{questionId} {
      allow create: if isSignedIn();
      allow get, list: if isAdminOrOwner();
      allow update, delete: if isAdminOrOwner();
    }

    // Admin Notifications
    match /admin_notifications/{notificationId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if isAdminOrOwner();
    }

    // Public Site Stats & View Counter (schema-checked & monotonic against tampering/reset)
    match /site_stats/{statId} {
      allow get: if true;
      allow create: if statId == 'main_counter'
        && incoming().keys().hasOnly(['id', 'totalViews', 'uniqueVisitors', 'totalAppDownloads', 'androidDownloads', 'iosDownloads', 'desktopDownloads', 'lastVisitedAt', 'lastDownloadedAt', 'createdAt'])
        && incoming().id == 'main_counter'
        && incoming().get('totalViews', 0) is int && incoming().get('totalViews', 0) >= 0 && incoming().get('totalViews', 0) <= 5000;
      allow update: if statId == 'main_counter'
        && incoming().keys().hasOnly(['id', 'totalViews', 'uniqueVisitors', 'totalAppDownloads', 'androidDownloads', 'iosDownloads', 'desktopDownloads', 'lastVisitedAt', 'lastDownloadedAt', 'createdAt'])
        && incoming().get('totalViews', 0) is int
        && incoming().get('totalViews', 0) >= existing().get('totalViews', 0)
        && incoming().get('totalViews', 0) <= existing().get('totalViews', 0) + 10
        && incoming().get('totalAppDownloads', 0) is int
        && incoming().get('totalAppDownloads', 0) >= existing().get('totalAppDownloads', 0)
        && incoming().get('totalAppDownloads', 0) <= existing().get('totalAppDownloads', 0) + 5;
      allow delete: if isAdminOrOwner();
    }
  }
}
